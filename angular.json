{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "eps-front": {
      "projectType": "application",
      "schematics": {"@schematics/angular:component": {"style": "css"}},
      "root": "",
      "sourceRoot": "src",
      "prefix": "sidi",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/eps-front",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {"budgets": [{"type": "initial", "maximumWarning": "1.2mb", "maximumError": "2mb"}], "outputHashing": "all"},
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"proxyConfig": "proxy.conf.json"},
          "configurations": {
            "production": {"buildTarget": "eps-front:build:production"},
            "development": {"buildTarget": "eps-front:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {"analytics": false}
}
